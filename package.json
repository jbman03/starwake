{
  "name": "starwake",
  "version": "0.1.0",
  "description": "Starwake: a browser space game",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "phaser": "4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "private": true
}
